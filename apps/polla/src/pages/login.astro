---
import Layout from '../layouts/Layout.astro';
import { LoginForm } from '@predictor/ui';

// Redirect if already authenticated
if (Astro.locals.user) {
  return Astro.redirect('/polla/');
}
---

<Layout title="Login">
  <main class="flex min-h-screen items-center justify-center bg-neutral p-6">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <span class="text-5xl">⚽</span>
        <h1 class="mt-4 font-heading text-h2 font-semibold text-primary">Predictor</h1>
        <p class="mt-1 text-secondary text-body-sm">Sign in to make your predictions</p>
      </div>
      <div class="rounded-md border border-border bg-surface p-5">
        <LoginForm client:load redirectTo="/polla/" />
      </div>
      <p class="mt-4 text-center text-body-sm text-muted">
        Back to <a href="/" class="text-tertiary hover:underline">main site</a>
      </p>
    </div>
  </main>
</Layout>
