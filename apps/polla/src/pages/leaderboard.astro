---
import Layout from '../layouts/Layout.astro';
import LeaderboardTable from '../components/LeaderboardTable';

const userId = Astro.locals.user?.id as string | undefined;
---

<Layout title="Leaderboard">
  <main class="max-w-4xl mx-auto p-6">
    <header class="text-center mb-8">
      <h1 class="font-heading text-h2 font-semibold text-primary">Leaderboard</h1>
      <p class="mt-2 text-secondary text-body-sm">See how you stack up against the competition</p>
    </header>

    <LeaderboardTable client:load currentUser={userId} />

    <nav class="mt-8 flex justify-center gap-8">
      <a href="/polla/" class="text-tertiary hover:underline text-body-sm">← Back to Home</a>
      <a href="/polla/predictions" class="text-tertiary hover:underline text-body-sm">Make Predictions →</a>
    </nav>
  </main>
</Layout>
