---
import predictionsIcon from "@predictor/ui/icons/predictions.svg";
import standingsIcon from "@predictor/ui/icons/standings.svg";
import rulesIcon from "@predictor/ui/icons/rules.svg";
import adminIcon from "@predictor/ui/icons/admin.svg";

import Layout from "../layouts/Layout.astro";
import { createT } from "@predictor/i18n";

// Server-side session check (middleware also guards this route)
const user = Astro.locals.user;
const displayName = Astro.locals.displayName;
const isAdmin = Astro.locals.isAdmin as boolean;
const lang = Astro.locals.lang;
const { t } = createT(lang);
---

<Layout title={t("polla.home.pageTitle")}>
  <div class="max-w-4xl">
    {
      user && (
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-primary">
            {t("polla.home.welcomeBack", { name: displayName ?? "" })}
          </h1>
          <p class="text-secondary mt-1">{t("polla.home.tagline")}</p>
          <p class="mt-1 text-secondary text-body-sm">
            {t("polla.home.description")}
          </p>
        </div>
      )
    }

    <nav class={`grid grid-cols-1 gap-4 max-w-3xl ${isAdmin ? 'sm:grid-cols-4' : 'sm:grid-cols-3'}`}>
      <a
        href="/polla/predictions"
        class="flex flex-col items-center gap-2 rounded-md border border-border bg-surface p-5 hover:border-tertiary transition-colors"
      >
        <img src={predictionsIcon.src} class="w-8 h-8" alt="" />
        <span class="font-label text-label-md font-medium"
          >{t("polla.home.predictionsCard")}</span
        >
      </a>
      <a
        href="/polla/leaderboard"
        class="flex flex-col items-center gap-2 rounded-md border border-border bg-surface p-5 hover:border-tertiary transition-colors"
      >
        <img src={standingsIcon.src} class="w-8 h-8" alt="" />
        <span class="font-label text-label-md font-medium">{t("polla.home.leaderboardCard")}</span>
      </a>
      <a
        href="/polla/rules"
        class="flex flex-col items-center gap-2 rounded-md border border-border bg-surface p-5 hover:border-tertiary transition-colors"
      >
        <img src={rulesIcon.src} class="w-8 h-8" alt="" />
        <span class="font-label text-label-md font-medium">{t("polla.home.rulesCard")}</span>
      </a>
      {
        isAdmin && (
          <a
            href="/polla/admin"
            class="flex flex-col items-center gap-2 rounded-md border border-border bg-surface p-5 hover:border-tertiary transition-colors"
          >
            <img src={adminIcon.src} class="w-8 h-8" alt="" />
            <span class="font-label text-label-md font-medium">{t("polla.home.adminCard")}</span>
          </a>
        )
      }
    </nav>
  </div>
</Layout>
