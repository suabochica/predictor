---
import Layout from "../layouts/Layout.astro";

// Server-side session check (middleware also guards this route)
const user = Astro.locals.user;
const displayName = Astro.locals.displayName;
---

<Layout title="Home">
  <div class="max-w-4xl">
    {
      user && (
        <div class="mb-8">
          <h1 class="font-heading text-xl font-semibold text-primary">
            Welcome back, {displayName}!
          </h1>
          <p class="mt-1 text-secondary text-body-sm">
            Predict match scores and compete with friends. Earn points based on accuracy!
          </p>
        </div>
      )
    }

    <nav class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl">
      <a
        href="/polla/predictions"
        class="flex flex-col items-center gap-2 rounded-md border border-border bg-surface p-5 hover:border-tertiary transition-colors"
      >
        <span class="text-3xl">⚽</span>
        <span class="font-label text-label-md font-medium"
          >Make Predictions</span
        >
      </a>
      <a
        href="/polla/leaderboard"
        class="flex flex-col items-center gap-2 rounded-md border border-border bg-surface p-5 hover:border-tertiary transition-colors"
      >
        <span class="text-3xl">📊</span>
        <span class="font-label text-label-md font-medium">Leaderboard</span>
      </a>
      <a
        href="/polla/rules"
        class="flex flex-col items-center gap-2 rounded-md border border-border bg-surface p-5 hover:border-tertiary transition-colors"
      >
        <span class="text-3xl">📋</span>
        <span class="font-label text-label-md font-medium">Scoring Rules</span>
      </a>
    </nav>
  </div>
</Layout>
