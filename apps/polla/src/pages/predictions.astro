---
import Layout from '../layouts/Layout.astro';
import PredictionForm from '../components/PredictionForm';

const userId = Astro.locals.user?.id as string | undefined;
---

<Layout title="Predictions">
  <main class="max-w-4xl mx-auto p-6">
    <header class="text-center mb-8">
      <h1 class="font-heading text-h2 font-semibold text-primary">Match Predictions</h1>
      <p class="mt-2 text-secondary text-body-sm">Enter your predicted scores (0–9). Save before leaving.</p>
    </header>

    <PredictionForm client:load currentUser={userId} />
  </main>
</Layout>
