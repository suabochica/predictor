---
import Layout from "../layouts/Layout.astro";
import PredictionForm from "../components/PredictionForm";
import { createT } from "@predictor/i18n";

const userId = Astro.locals.user?.id as string | undefined;
const totalPoints = Astro.locals.totalPoints ?? 0;
const lang = Astro.locals.lang;
const { t } = createT(lang);
---

<Layout title={t("polla.predictions.pageTitle")}>
  <div class="max-w-4xl">
    <h1 class="text-2xl font-bold text-primary">{t("polla.predictions.heading")}</h1>
    <p class="text-secondary text-body-sm mt-1 mb-6">
      {t("polla.predictions.description")} <span
        class="font-bold text-tertiary">{totalPoints} {t("polla.predictions.pointsSuffix")}</span
      >
    </p>

    <PredictionForm client:load currentUser={userId} lang={lang} />
  </div>
</Layout>
