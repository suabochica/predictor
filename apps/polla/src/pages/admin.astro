---
import Layout from '../layouts/Layout.astro';
import AdminTable from '../components/AdminTable';
import KnockoutAdmin from '../components/KnockoutAdmin';
import { createT } from '@predictor/i18n';

const isAdmin = Astro.locals.isAdmin as boolean;

if (!isAdmin) {
  return Astro.redirect(`${import.meta.env.PUBLIC_GATEWAY_URL ?? ''}/`);
}

const lang = Astro.locals.lang;
const { t } = createT(lang);
---

<Layout title={t("polla.admin.pageTitle")}>
  <div class="max-w-5xl space-y-10">
    <section>
      <h1 class="text-2xl font-bold text-primary">{t("polla.admin.knockout.heading")}</h1>
      <p class="text-secondary text-body-sm mt-1 mb-6">
        {t("polla.admin.knockout.description")}
      </p>
      <KnockoutAdmin client:load lang={lang} />
    </section>

    <section>
      <h1 class="text-2xl font-bold text-primary">{t("polla.admin.groupStage.heading")}</h1>
      <p class="text-secondary text-body-sm mt-1 mb-6">
        {t("polla.admin.groupStage.description")}
      </p>
      <AdminTable client:load lang={lang} />
    </section>
  </div>
</Layout>
