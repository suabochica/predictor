---
import Layout from '../layouts/Layout.astro';
import AdminTable from '../components/AdminTable';
import KnockoutAdmin from '../components/KnockoutAdmin';

const isAdmin = Astro.locals.isAdmin as boolean;

if (!isAdmin) {
  return Astro.redirect(`${import.meta.env.PUBLIC_GATEWAY_URL ?? ''}/`);
}
---

<Layout title="Admin">
  <div class="max-w-5xl space-y-10">
    <section>
      <h1 class="text-2xl font-bold text-primary">Predicciones partidos de eliminación</h1>
      <p class="text-secondary text-body-sm mt-1 mb-6">
        Administrar los partidos de las fases de eliminación directa: dieciseisavos, octavos, cuartos, semifinal, tercer lugar y final.
      </p>
      <KnockoutAdmin client:load />
    </section>

    <section>
      <h1 class="text-2xl font-bold text-primary">Predicciones partidos de la fase de grupos</h1>
      <p class="text-secondary text-body-sm mt-1 mb-6">
        Ver todas las predicciones de las fases de grupos enviadas por cada usuario, agrupadas por partido.
      </p>
      <AdminTable client:load />
    </section>
  </div>
</Layout>
