---
import Layout from '../layouts/Layout.astro';
import AdminTable from '../components/AdminTable';

const isAdmin = Astro.locals.isAdmin as boolean;

if (!isAdmin) {
  return Astro.redirect(`${import.meta.env.PUBLIC_GATEWAY_URL ?? ''}/`);
}
---

<Layout title="Admin">
  <div class="max-w-5xl">
    <h1 class="text-2xl font-bold text-primary">Admin — All Predictions</h1>
    <p class="text-secondary text-body-sm mt-1 mb-6">
      View all predictions submitted by every user, grouped by match.
    </p>

    <AdminTable client:load />
  </div>
</Layout>
