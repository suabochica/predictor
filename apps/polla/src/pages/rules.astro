---
import Layout from "../layouts/Layout.astro";
import RulesEs from "../components/Rules.es.astro";
import RulesEn from "../components/Rules.en.astro";
import { createT } from "@predictor/i18n";

const lang = Astro.locals.lang;
const { t } = createT(lang);
---

<Layout title={t("polla.rules.pageTitle")}>
  {lang === "en" ? <RulesEn /> : <RulesEs />}
</Layout>
