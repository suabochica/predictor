---
const base = '/polla';
---

<header class="sticky top-0 z-50 bg-surface border-b border-border text-primary">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href={base} class="flex items-center gap-2 font-bold text-lg text-tertiary hover:text-tertiary">
      <span class="text-2xl">🏆</span>
      <span class="hidden sm:inline">WC2026 Polla</span>
    </a>

    <nav class="flex items-center gap-6 text-sm font-medium">
      <a href="/" class="hover:text-tertiary transition-colors">Dashboard</a>
      <a href={`${base}/predictions`} class="hover:text-tertiary transition-colors">Predictions</a>
      <a href={`${base}/leaderboard`} class="hover:text-tertiary transition-colors">Leaderboard</a>
      <a href={`${base}/rules`} class="hover:text-tertiary transition-colors">Rules</a>
    </nav>

    <a href="/auth/signout" class="text-sm text-secondary hover:text-primary transition-colors">Sign out</a>
  </div>
</header>
