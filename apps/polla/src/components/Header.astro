---
import pollaIcon from '@predictor/ui/icons/polla.svg';
import { BUTTON_PRIMARY_CLASSES } from '@predictor/ui';

const base = '/polla/';
---

<header class="sticky top-0 z-50 bg-surface border-b border-border text-primary">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href={base} class="flex items-center gap-2 font-atomic font-bold text-lg text-tertiary hover:text-tertiary">
      <img src={pollaIcon.src} class="w-6 h-6" alt="" />
      <span class="hidden sm:inline">Polla</span>
    </a>

    <div class="flex items-center gap-3">
      {Astro.locals.isAdmin && (
        <span
          class="text-xs bg-warning text-primary font-bold px-2 py-1 rounded"
        >
          Admin
        </span>
      )}
      <form method="POST" action="/auth/signout">
        <button type="submit" class={BUTTON_PRIMARY_CLASSES}>Sign out</button>
      </form>
    </div>
  </div>
</header>
