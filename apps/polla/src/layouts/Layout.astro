---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { Header, Footer } from '@predictor/ui';
import { createT } from '@predictor/i18n';
import pollaIcon from '@predictor/ui/icons/polla.svg';
import fantasyIcon from '@predictor/ui/icons/fantasy.svg';

export interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const lang = Astro.locals.lang;
const currentUrl = Astro.url.pathname + Astro.url.search;
const { t } = createT(lang);
---

<!doctype html>
<html lang={Astro.locals.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Predictor</title>
  </head>
  <body class="min-h-screen bg-neutral text-primary flex flex-col">
    <Header
      appName="Polla"
      appIcon={pollaIcon.src}
      basePath="/polla/"
      isAdmin={Astro.locals.isAdmin ?? false}
      adminLabel={t('common.header.admin')}
      isAuthenticated={!!user}
      showLogin
      loginLabel={t('common.header.login')}
      logoutLabel={t('common.header.logout')}
      otherAppIcon={fantasyIcon.src}
      otherAppPath="/fantasy/"
      otherAppTitle={t('common.header.goTo', { app: 'Fantasy' })}
      lang={lang}
      currentUrl={currentUrl}
    />
    <div class="flex flex-1">
      {user && <Sidebar />}
      <main class={`flex-1 p-4 md:p-6 ${user ? 'max-w-full' : ''}`}>
        <slot />
      </main>
    </div>
    <Footer
      lang={lang}
      homeLabel={t('common.footer.home')}
      lastUpdatedLabel={t('common.footer.lastUpdated')}
      madeByLabel={t('common.footer.madeBy')}
      andLabel={t('common.footer.and')}
    />
  </body>
</html>
