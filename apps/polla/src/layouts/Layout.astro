---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { Header, Footer } from '@predictor/ui';
import pollaIcon from '@predictor/ui/icons/polla.svg';
import fantasyIcon from '@predictor/ui/icons/fantasy.svg';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Predictor</title>
  </head>
  <body class="min-h-screen bg-neutral text-primary font-body flex flex-col">
    <Header
      appName="Polla"
      appIcon={pollaIcon.src}
      basePath="/polla/"
      isAdmin={Astro.locals.isAdmin ?? false}
      otherAppIcon={fantasyIcon.src}
      otherAppPath="/fantasy/"
    />
    <div class="flex flex-1">
      <Sidebar />
      <main class="flex-1 p-4 md:p-6">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
