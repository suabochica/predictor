---
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Predictor</title>
  </head>
  <body class="min-h-screen bg-neutral text-primary font-body flex flex-col">
    <slot />
    <footer class="mt-auto py-6 text-center text-body-sm text-muted border-t border-border">
      <div class="flex items-center justify-center gap-4">
        <a href="/" class="hover:text-tertiary transition-colors">Dashboard</a>
        <span class="text-muted/50">•</span>
        <a href="/polla/" class="hover:text-tertiary transition-colors">Polla</a>
        <span class="text-muted/50">•</span>
        <a href="/fantasy/" class="hover:text-tertiary transition-colors">Fantasy</a>
      </div>
      <p class="mt-2">World Cup 2026 • June 11 – July 19, 2026</p>
    </footer>
  </body>
</html>
