---
import '../styles/global.css';
import { LOCALES, buildLangHref } from '@predictor/i18n';

interface Props {
  title: string;
}
const { title } = Astro.props;
const lang = Astro.locals.lang;
const currentUrl = Astro.url.pathname + Astro.url.search;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} — Predictor</title>
  </head>
  <body class="min-h-screen bg-neutral text-primary font-body">
    <div class="flex justify-end gap-2 px-4 pt-3 text-xs font-semibold text-muted">
      {LOCALES.map((l) => (
        <a
          href={buildLangHref(currentUrl, l)}
          aria-current={l === lang}
          class={l === lang ? "text-tertiary" : "hover:text-tertiary transition-colors"}
        >
          {l.toUpperCase()}
        </a>
      ))}
    </div>
    <slot />
  </body>
</html>
