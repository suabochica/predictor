---
import Layout from '../layouts/Layout.astro';
import { LoginForm } from '@predictor/ui';

// Redirect if already logged in
if (Astro.locals.user) {
  return Astro.redirect('/');
}
---

<Layout title="Login">
  <main class="flex min-h-screen items-center justify-center p-6">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <span class="text-5xl">⚽</span>
        <h1 class="mt-4 font-heading text-h2 font-semibold text-primary">Predictor</h1>
        <p class="mt-1 text-secondary text-body-sm">Sign in to make your predictions</p>
      </div>
      <div class="rounded-md border border-border bg-surface p-5">
        <LoginForm client:load />
      </div>
      <p class="mt-6 text-center text-body-sm text-muted">
        No account? <a href="/register" class="text-tertiary hover:underline">Register</a>
      </p>
    </div>
  </main>
</Layout>
