---
import Layout from '../layouts/Layout.astro';
import RegisterForm from '../components/RegisterForm';

if (Astro.locals.user) {
  return Astro.redirect('/');
}
---

<Layout title="Registrarse">
  <main class="flex min-h-screen items-center justify-center p-6">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <span class="text-5xl">⚽</span>
        <h1 class="mt-4 font-heading text-h2 font-semibold text-primary">Crear cuenta</h1>
        <p class="mt-1 text-secondary text-body-sm">Únete a la liga de predicciones del Mundial 2026</p>
      </div>
      <RegisterForm client:load />
      <p class="mt-6 text-center text-body-sm text-muted">
        ¿Ya tienes cuenta? <a href="/login" class="text-tertiary hover:underline">Iniciar sesión</a>
      </p>
    </div>
  </main>
</Layout>
