---
import { BUTTON_PRIMARY_CLASSES } from "@predictor/ui";
import { createT } from "@predictor/i18n";
import pollaIcon from "@predictor/ui/icons/polla.svg";
import fantasyIcon from "@predictor/ui/icons/fantasy.svg";

import Layout from "../layouts/Layout.astro";
import AppCard from "../components/AppCard";

const displayName = Astro.locals.displayName;
const lang = Astro.locals.lang;
const { t } = createT(lang);
---

<Layout title={t("gateway.home.title")}>
  <main
    class="flex min-h-screen flex-col items-center justify-center gap-10 p-6"
  >
    <div class="text-center">
      <h1 class="font-heading text-h2 font-semibold text-primary">
        {t("gateway.home.welcome")}{displayName ? `, ${displayName}` : ""}
      </h1>
      <p class="mt-2 text-secondary text-body-sm">
        {t("gateway.home.subtitle")}
      </p>
    </div>

    <div class="grid w-full max-w-2xl grid-cols-1 gap-6 sm:grid-cols-2">
      <AppCard
        name="Polla"
        description={t("gateway.home.pollaDescription")}
        href="/polla/"
        icon={pollaIcon.src}
      />
      <AppCard
        name="Fantasy"
        description={t("gateway.home.fantasyDescription")}
        href="/fantasy/"
        icon={fantasyIcon.src}
      />
    </div>

    {/* Prizes section hidden: the copy still describes the 2026 World Cup
        entry fee and payout split, which does not apply to UCL 2026/27.
        Premiacion.{es,en}.astro are kept so the text can be updated and this
        block restored, rather than rewritten. */}

    <form method="POST" action="/auth/signout">
      <button type="submit" class={BUTTON_PRIMARY_CLASSES}>
        {t("common.header.logout")}
      </button>
    </form>
  </main>
</Layout>
